APP_ENV=development

DATABASE_URL=postgresql+psycopg2://email_intel:email_intel@localhost:5432/email_intel

STORAGE_USE_LOCAL_FS=true
LOCAL_STORAGE_PATH=./data/raw
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=email-intel-raw
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

MAX_UPLOAD_FILE_SIZE_BYTES=209715200
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

ANOMALY_Z_SCORE_THRESHOLD=2.5
ANOMALY_MIN_HISTORY_POINTS=7
ANOMALY_IQR_MULTIPLIER=1.5

RISK_WEIGHT_HARD_BOUNCE=0.35
RISK_WEIGHT_SOFT_BOUNCE=0.15
RISK_WEIGHT_FAILURE_RATE=0.25
RISK_WEIGHT_FAILURE_STREAK=0.15
RISK_WEIGHT_RECENCY=0.10

RETRY_WINDOW_MINUTES=60
DUPLICATE_TIMESTAMP_BUCKET_SECONDS=60

CACHE_TTL_SECONDS=300
DEFAULT_TIMEZONE=Asia/Kolkata
